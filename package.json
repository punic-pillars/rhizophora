{
  "name": "rhizophora",
  "version": "0.1.5",
  "description": "MCP server for React Native layout analysis. AST-driven Vein Propagation Engine that reveals hidden component structure, detects layout gaps, bridge crossings, render traps, and SharedValue lifecycle issues. 13 tools for structural analysis, layout auditing, performance profiling, and semantic orchestration.",
  "keywords": [
    "mcp-server",
    "mcp",
    "model-context-protocol",
    "react-native",
    "ui",
    "design-tokens",
    "static-analysis",
    "ast",
    "code-analysis",
    "layout-analysis",
    "performance-profiling",
    "react-native-tools",
    "typescript",
    "component-analysis",
    "reanimated"
  ],
  "license": "MIT",
  "author": "punic-pillars",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/punic-pillars/rhizophora.git"
  },
  "bugs": {
    "url": "https://github.com/punic-pillars/rhizophora/issues"
  },
  "homepage": "https://github.com/punic-pillars/rhizophora#readme",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "rhizophora": "build/index.js",
    "rhizophora-cli": "build/cli.js"
  },
  "files": [
    "build/"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "ci": "node build/cli.js --ci",
    "cli": "node build/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@typescript-eslint/parser": "^8.59.2",
    "@typescript-eslint/typescript-estree": "^8.59.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "typescript": "^5.4.0"
  }
}
